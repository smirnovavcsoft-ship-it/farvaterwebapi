import { test, expect } from '@playwright/test';

// 1. Настройка: установите базовый URL в playwright.config.ts
//    (например, baseURL: 'https://jsonplaceholder.typicode.com')

test.describe('API Tests for Users', () => {

    test('should fetch a user by ID', async ({ request }) => {
        // 'request' - это фиксчур, который Playwright предоставляет для API-запросов.
        const response = await request.get('/users/1');

        // Проверка HTTP-статуса
        expect(response.status()).toBe(200);

        // Проверка заголовка (Content-Type)
        expect(response.headers()['content-type']).toContain('application/json');

        // Получение тела ответа в виде JSON
        const responseBody = await response.json();

        // Проверка данных в теле ответа
        expect(responseBody.id).toBe(1);
        expect(responseBody.name).toBe('Leanne Graham');
    });

    // Пример POST-запроса
    test('should create a new user', async ({ request }) => {
        const payload = {
            name: 'John Doe',
            job: 'Tester',
        };

        const response = await request.post('/users', {
            data: payload,
        });

        expect(response.status()).toBe(201);
        const responseBody = await response.json();
        
        // Проверка, что отправленные данные присутствуют в ответе
        expect(responseBody.name).toBe(payload.name);
    });
});