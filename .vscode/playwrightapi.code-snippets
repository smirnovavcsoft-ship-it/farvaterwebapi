	"Playwright API Hooks Only": {
		"prefix": "pwapihooks",
		"scope": "typescript",
		"body": [
			"import { test, expect, APIRequestContext } from '@playwright/test';",
			"",
			"let request: APIRequestContext;",
			"",
			"test.describe('${1:APITestSuiteName}', () => {",
			"\t// Хук: Настройка контекста и авторизации (Выполняется 1 раз перед всеми тестами)",
			"\ttest.beforeAll(async({ playwright, baseURL }) => {",
			"\t\trequest = await playwright.request.newContext({",
			"\t\t\tbaseURL: baseURL, // Используем базовый URL из конфигурации Playwright",
			"\t\t\textraHTTPHeaders: {",
			"\t\t\t\t'Authorization' : `Bearer ${2:ACCESS_TOKEN_VAR}`,",
			"\t\t\t\t'Content-Type': 'application/json', ",
			"\t\t\t},",
			"\t\t});",
			"\t});",
			"",
			"\t// Здесь будут основные тесты (например, test('...', async () => { ... }))",
			"\t$3",
			"",
			"\t// Хук: Очистка (выполняется один раз после всех тестов)",
			"\ttest.afterAll(async () => {",
			"\t\tif (request) {",
			"\t\t\tawait request.dispose();",
			"\t\t}",
			"\t});",
			"});"
		],
		"description": "Базовый шаблон Playwright API-теста с beforeAll (инициализация контекста) и afterAll (очистка)."
	},

	"Playwright GET Request with File Save": {
		"prefix": "pwgetsave",
		"scope": "typescript",
		"body": [
			"// GET: Получить ${1:все_пользователи}",
			"const getResponse = await ${2:request}.get(${3:USERS_URL});",
			"expect(getResponse.status()).toBe(200);",
			"const ${4:allUsers} = await getResponse.json();",
			"",
			"// 🚀 ШАГ: ЗАПИСЬ ОТВЕТА В ФАЙЛ",
			"const jsonResponse = JSON.stringify(${4:allUsers}, null, 2); ",
			"const filePath = './test_output/${5:all_users_list}.json';",
			"// 💡 Создаем директорию, если она не существует",
			"if (!fs.existsSync('./test_output')) {",
			"\tfs.mkdirSync('./test_output');",
			"}",
			"fs.writeFileSync(filePath, jsonResponse);",
			"console.log(`✅ Ответ API сохранен в: ${filePath}`);",
			"$6"
		],
		"description": "Шаблон GET-запроса Playwright с проверкой статуса и сохранением JSON-ответа в файл."
	}






